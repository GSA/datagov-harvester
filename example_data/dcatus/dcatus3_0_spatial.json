{
  "@type": "Catalog",
  "@id": "https://example.gov/spatial.json",
  "conformsTo": {
    "@type": "Standard",
    "title": "DCAT-US 3.0"
  },
  "title": "Example DCAT-US 3.0 Catalog (spatial)",
  "description": "A sample DCAT-US 3.0 catalog exercising Location-object spatial handling.",
  "dataset": [
    {
      "@type": "Dataset",
      "title": "Spatial Dataset One (array, WKT geometry)",
