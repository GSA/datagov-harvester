      }
    },
    {
      "@type": "Dataset",
      "title": "Spatial Dataset Four (unresolvable prefLabel)",
      "description": "Location object with only a prefLabel that can't be resolved.",
      "identifier": "https://example.gov/datasets/spatial-four",
      "publisher": {
        "@type": "Organization",
        "name": "Test Agency"
      },
      "contactPoint": {
        "@type": "Kind",
        "fn": "Test Contact Four",
        "hasEmail": "mailto:spatial-four@example.gov"
      },
      "spatial": {
        "@type": "Location",
        "prefLabel": "Nowheresville"
      }
    }
