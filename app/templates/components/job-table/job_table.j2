{# Map a job status to AA-contrast USWDS tag background utilities. Unknown
   statuses fall back to a plain usa-tag (neutral). #}
{% set _status_tag = {
    'error': 'bg-error-dark text-white',
    'in_progress': 'bg-warning',
    'complete': 'bg-success-dark text-white',
} %}
{% macro job_table(jobs, caption, show_source=true, show_progress=False) -%}
<div class="usa-table-container--scrollable" tabindex="0">
    <table class="usa-table usa-table--striped usa-table--borderless job-table">
        <caption>{{ caption }}</caption>
        <thead>
            <tr>
                <th rowspan="2" scope="col" class="job-table-id" title="Job ID">Job ID</th>
                {% if show_source %}<th rowspan="2" scope="col" class="job-table-source" title="Harvest Source">Source</th>{% endif %}
                <th rowspan="2" scope="col" class="job-table-status" title="Job Status">Status</th>
                {% if show_progress %}
                    <th rowspan="2" scope="col" class="job-table-progress" title="Job Progress">Progress</th>
                {% endif %}
                <th rowspan="2" scope="col" class="job-table-type" title="Job Type">Type</th>
                <th rowspan="2" scope="col" class="job-table-started" title="Start Date">Started</th>
                <th rowspan="2" scope="col" class="job-table-duration" title="Elapsed Time">Duration</th>
                <th colspan="6" scope="colgroup" class="job-count-group-header">Record Counts</th>
            </tr>
            <tr>
                <th scope="col" class="job-count-header job-count-added" title="Records Added"><span>Added</span></th>
                <th scope="col" class="job-count-header job-count-updated" title="Records Updated"><span>Updated</span></th>
                <th scope="col" class="job-count-header job-count-deleted" title="Records Deleted"><span>Deleted</span></th>
                <th scope="col" class="job-count-header job-count-errored" title="Records Errored"><span>Errored</span></th>
                <th scope="col" class="job-count-header job-count-warned" title="Records Warned"><span>Warned</span></th>
                <th scope="col" class="job-count-header job-count-unchanged" title="Records Unchanged"><span>Unchanged</span></th>
            </tr>
        </thead>
        <tbody id="paginated_harvest_jobs">
            {% for job in jobs %}
            {% set status_class = _status_tag.get(job.status, '') %}
            <tr>
                <td class="job-table-id" data-sort-value="{{ job.id }}">
                    <a href="{{ url_for('main.view_harvest_job', job_id=job.id) }}">
                        {{ job.id[:6] }}
                    </a>
                </td>
                {% if show_source %}
                <td class="job-table-source" data-sort-value="{{ job.source.name }}">
                    <a href="{{ url_for('main.view_harvest_source', source_id=job.source.id) }}" title="{{ job.source.name }}">
                        <span class="display-none tablet:display-inline">{{ job.source.name[:25] }}{% if job.source.name|length > 25 %}...{% endif %}</span>
                        <span class="tablet:display-none">{{ job.source.name[:12] }}{% if job.source.name|length > 12 %}...{% endif %}</span>
                    </a>
                </td>
                {% endif %}
                <td class="job-table-status">
                    <span class="usa-tag {{ status_class }} display-none tablet:display-inline">{{ job.status }}</span>
                    <span class="usa-tag {{ status_class }} tablet:display-none">{{ job.status[:4] }}</span>
                </td>
                {% if show_progress %}
                    <td class="job-table-progress">
                        <div class="progress-meter">
                            {# [:-1] slices off "%" #}
                            <style nonce="{{ csp_nonce() }}">
                              .progress-{{ job.id }} {
                                --progress: {{ job.percent_complete[:-1] }};
                              }
                            </style>
                            <div class="progress-percent progress-{{ job.id }}"></div>
                        </div>
                    </td>
                {% endif %}
                <td class="job-table-type text-tabular">{{ job.job_type }}</td>
                <td class="job-table-started font-mono-sm text-no-wrap utc-date-two-line" data-utc-date="{{ job.date_started | utc_isoformat }}">
                    {{ job.date_started | else_na}}
                </td>
                {% if job.date_finished %}
                <td class="job-table-duration font-mono-sm text-no-wrap utc-date-title" data-utc-date="{{ job.date_finished | utc_isoformat }}">
                    {{ job.date_started | elapsed_time(job.date_finished) }}
                </td>
                {% elif job.status == 'in_progress' %}
                <td class="job-table-duration font-mono-sm text-no-wrap">
                    In progress
                </td>
                {% else %}
                <td class="job-table-duration font-mono-sm text-no-wrap">
                    N/A
                </td>
                {% endif %}
                <td class="job-count-cell job-count-added text-tabular text-right">{{ job.records_added }}</td>
                <td class="job-count-cell job-count-updated text-tabular text-right">{{ job.records_updated }}</td>
                <td class="job-count-cell job-count-deleted text-tabular text-right">{{ job.records_deleted }}</td>
                <td class="job-count-cell job-count-errored text-tabular text-right">{{ job.records_errored }}</td>
                <td class="job-count-cell job-count-warned text-tabular text-right">{{ job.records_warned | default(0, true) }}</td>
                <td class="job-count-cell job-count-unchanged text-tabular text-right">{{ job.records_ignored }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    <div class="usa-sr-only usa-table__announcement-region" aria-live="polite"></div>
</div>
{% endmacro -%}
