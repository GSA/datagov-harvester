# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
ignore:
  SNYK-PYTHON-WERKZEUG-14151620:
    - "*":
        reason: >-
          No remediation available yet until flask updates underlying
          werkzeug dependency. However, we don't use werkzeug as our deployed WSGI server
          (we use gunicorn) so this only affects local development.
        expires: 2026-03-01T00:00:00.000Z
  SNYK-PYTHON-LOGURU-22132235:
    - "*":
        reason: >-
          Medium severity ReDoS vulnerability in loguru@0.7.3 dependency via
          geojson-validator. No upgrade or patch available. Risk is acceptable
          as loguru is only used for logging, not processing untrusted input.
        expires: 2027-05-01T00:00:00.000Z
        created: 2026-11-03T14:26:31.000Z
patch: {}
exclude:
  global:
    - scripts/
    - app/commands
